# Enforce consistent line endings across Windows, macOS, and Linux
* text=auto eol=lf

# Shell and Python scripts MUST always use LF so macOS/Linux shebangs never break
*.sh text eol=lf
*.py text eol=lf

# Source, config, web, and docs use LF
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.svg text eol=lf
LICENSE text eol=lf

# Windows PowerShell scripts use CRLF
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
